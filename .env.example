# Local development uses a SQLite file. In production point this at a
# persistent disk, e.g. on Railway with a volume mounted at /data:
#   DATABASE_URL="file:/data/app.db"
#
# For Postgres later:
#   DATABASE_URL="postgresql://user:pass@host:5432/emailpreviews"
# and change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Name of the session cookie.
SESSION_COOKIE_NAME="ep_session"

# Set to 1 to allow running with a database that will not survive a redeploy.
# Only for throwaway demos -- the app otherwise refuses to start in that state.
# ALLOW_EPHEMERAL_DB=1
