# PostgreSQL connection string.
#
# On Railway this is provided by the Postgres service -- in your app service add
# a variable named DATABASE_URL with the value ${{Postgres.DATABASE_URL}} so the
# two are linked.
#
# For local development you can either point at your own Postgres, or copy
# DATABASE_PUBLIC_URL from the Railway Postgres service (Variables tab) and use
# that here. The plain DATABASE_URL on Railway is only reachable from inside
# Railway's private network.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emailpreviews"

# Name of the session cookie.
SESSION_COOKIE_NAME="ep_session"
