// Datasource is PostgreSQL, which is what Railway provisions as a service.
//
// The schema deliberately sticks to the subset of Prisma that PostgreSQL and
// SQLite both support -- no `enum` blocks, no scalar lists, no native `Json`
// columns. Roles and JSON payloads are stored as `String`. That keeps the
// door open to running on a plain SQLite file (useful for a throwaway local
// instance) without a schema rewrite, and it means the two databases produce
// identical application behaviour.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
  sessions    Session[]
  revisions   RowRevision[]
  sentInvites Invite[]      @relation("InviteSender")
  createdRows SheetRow[]    @relation("RowCreator")
  hiddenRows  SheetRow[]    @relation("RowHider")
  approvals   Approval[]
  uploads     MediaAsset[]  @relation("MediaUploader")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A Company is the tenant: one store of content, many collaborating users.
model Company {
  id              String    @id @default(cuid())
  name            String
  createdAt       DateTime  @default(now())
  /// Storefront host for the product catalog, e.g. "museumofgraffiti.com".
  /// Null for a company that sells nothing -- content-only, like a services firm.
  shopDomain      String?
  /// When the product cache was last refreshed from that storefront.
  catalogSyncedAt DateTime?

  memberships Membership[]
  templates   Template[]
  sheets      ContentSheet[]
  invites     Invite[]
  media       MediaAsset[]
  products    CatalogProduct[]
  collections CatalogCollection[]
}

/// One product from the company's storefront, cached so the picker is instant.
///
/// A cache rather than a live call: a preview that hit the storefront for every
/// tile would be slow, would break when the store is briefly unreachable, and
/// would rate-limit itself on a sheet with sixty rows. Refreshed on demand.
/// A storefront collection, so a row can name one and have the grid fill itself.
model CatalogCollection {
  id           String   @id @default(cuid())
  companyId    String
  /// Shopify's collection id.
  externalId   String
  handle       String
  title        String
  /// What the storefront reported, which can outrun what we actually stored.
  productCount Int      @default(0)
  syncedAt     DateTime @default(now())

  company  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products CatalogCollectionProduct[]

  @@unique([companyId, handle])
  @@index([companyId, title])
}

/// Membership, carrying the storefront's own ordering.
model CatalogCollectionProduct {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  /// Position in the collection's own sort order, which is what "manual" means.
  position     Int

  collection CatalogCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    CatalogProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, position])
}

model CatalogProduct {
  id          String   @id @default(cuid())
  companyId   String
  /// Shopify's product id, stable across renames.
  externalId  String
  handle      String
  title       String
  vendor      String?
  productType String?
  url         String
  imageUrl    String?
  /// Formatted as the storefront gives it, e.g. "45.00". A string because it
  /// goes straight into a cell and then into the email verbatim.
  price       String?
  available   Boolean  @default(true)
  /// Comma-joined product tags, so the picker can search on them.
  tags        String   @default("")
  syncedAt    DateTime @default(now())

  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collections CatalogCollectionProduct[]

  @@unique([companyId, externalId])
  @@index([companyId, title])
}

/// Joins a login to a company. Roles: "owner" | "admin" | "member".
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("member")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Pending invitation for someone to join a company.
model Invite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        String    @default("member")
  token       String    @unique
  invitedById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
}

/// An HTML email template containing {{ placeholder_name }} tokens.
model Template {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  description  String?
  html         String
  /// JSON array of placeholder names discovered in `html`, cached on write.
  placeholders String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([companyId])
}

/// An uploaded .xlsx/.csv, parsed into records that live in the app.
model ContentSheet {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  sourceFilename String?
  /// JSON array of column headers, in sheet order.
  columns        String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rows    SheetRow[]

  @@index([companyId])
}

/// One record from a content sheet: the values for a single email.
model SheetRow {
  id          String    @id @default(cuid())
  sheetId     String
  position    Int
  /// JSON object mapping column header -> string value.
  data        String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  /// Set when someone hides the row: rejected outright, or not ready to show.
  /// A timestamp rather than a flag so the rail can say when, and by whom.
  hiddenAt    DateTime?
  hiddenById  String?

  sheet     ContentSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("RowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  hiddenBy  User?         @relation("RowHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  revisions RowRevision[]
  approvals Approval[]

  @@index([sheetId, position])
}

/// One person signing off one row as rendered in one template.
///
/// The approved thing is the pair, not the row: the same copy in a different
/// layout is a different email and is approved separately. `contentHash`
/// records what was actually on screen, so editing the copy afterwards leaves
/// the approval visibly stale instead of silently standing.
model Approval {
  id          String   @id @default(cuid())
  rowId       String
  templateId  String
  userId      String
  /// Fingerprint of the row values and template at the moment of approval.
  contentHash String
  createdAt   DateTime @default(now())

  row      SheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rowId, templateId, userId])
  @@index([rowId])
  @@index([templateId])
}

/// Immutable snapshot of a row's values, written on every save.
model RowRevision {
  id          String   @id @default(cuid())
  rowId       String
  /// JSON object: the row's values *before* this change.
  data        String
  changedById String?
  changedAt   DateTime @default(now())
  note        String?

  row       SheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([rowId, changedAt])
}

/// An image uploaded through the app and served publicly for use in emails.
///
/// The bytes live here rather than on disk or in a bucket so that anyone with
/// a login can add one -- a file committed to the repository can only ever be
/// added by whoever can push to it, which is the wrong shape for a tool the
/// whole team reviews in. Images are small and few; the database handles them
/// comfortably and they are covered by its backups.
model MediaAsset {
  id           String   @id @default(cuid())
  companyId    String
  /// Digest of the bytes. Doubles as the public path, so a URL always points
  /// at exactly the image it was created for and can be cached forever.
  sha256       String
  filename     String
  mimeType     String
  bytes        Bytes
  size         Int
  width        Int?
  height       Int?
  uploadedById String?
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// The same file uploaded twice is one asset, not two.
  @@unique([companyId, sha256])
  @@index([companyId, createdAt])
}
