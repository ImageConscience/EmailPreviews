// Datasource is PostgreSQL, which is what Railway provisions as a service.
//
// The schema deliberately sticks to the subset of Prisma that PostgreSQL and
// SQLite both support -- no `enum` blocks, no scalar lists, no native `Json`
// columns. Roles and JSON payloads are stored as `String`. That keeps the
// door open to running on a plain SQLite file (useful for a throwaway local
// instance) without a schema rewrite, and it means the two databases produce
// identical application behaviour.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
  sessions    Session[]
  revisions   RowRevision[]
  sentInvites Invite[]      @relation("InviteSender")
  createdRows SheetRow[]    @relation("RowCreator")
  hiddenRows  SheetRow[]    @relation("RowHider")
  approvals   Approval[]
  uploads     MediaAsset[]  @relation("MediaUploader")
  notes       RowNote[]
  pushes      KlaviyoPush[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A Company is the tenant: one store of content, many collaborating users.
model Company {
  id              String    @id @default(cuid())
  name            String
  createdAt       DateTime  @default(now())
  /// Storefront host for the product catalog, e.g. "museumofgraffiti.com".
  /// Null for a company that sells nothing -- content-only, like a services firm.
  shopDomain      String?
  /// When the product cache was last refreshed from that storefront.
  catalogSyncedAt DateTime?

  /// Klaviyo, for the clients where we hold a key. Encrypted with the app's
  /// ENCRYPTION_KEY rather than stored plainly: it can read a client's whole
  /// customer list and mail them, so a copy of this database on its own must
  /// not be enough to do either.
  klaviyoKeyCipher   String?
  /// The last four characters, which is all anyone needs to tell two keys apart.
  klaviyoKeyHint     String?
  /// Which Klaviyo account the key turned out to belong to. Shown wherever a
  /// push is offered: the dangerous mistake is not a bad key, it is a good key
  /// for the wrong client.
  klaviyoAccountName String?
  klaviyoAccountId   String?
  klaviyoFromEmail   String?
  klaviyoFromLabel   String?
  klaviyoReplyTo     String?
  /// The zone the sheet's send times are written in.
  klaviyoTimezone    String?
  klaviyoLinkedAt    DateTime?
  /// The drag-and-drop template in Klaviyo whose HTML block the content goes
  /// into. Cloned per send, so the header, footer and unsubscribe stay the
  /// client's and only the marked block is ours.
  klaviyoBaseTemplateId String?
  klaviyoBaseTemplateName String?
  /// Who sends go to when a row does not say otherwise, comma separated.
  ///
  /// A default rather than a per-row requirement because most of a client's
  /// campaigns go to the same place, and because an approval is fingerprinted
  /// against the row: filling an audience into every row after it had been
  /// approved would make every sign-off stale, every time.
  klaviyoAudience        String?
  klaviyoAudienceExclude String?

  memberships Membership[]
  templates   Template[]
  sheets      ContentSheet[]
  invites     Invite[]
  media       MediaAsset[]
  products    CatalogProduct[]
  collections CatalogCollection[]
}

/// One product from the company's storefront, cached so the picker is instant.
///
/// A cache rather than a live call: a preview that hit the storefront for every
/// tile would be slow, would break when the store is briefly unreachable, and
/// would rate-limit itself on a sheet with sixty rows. Refreshed on demand.
/// A storefront collection, so a row can name one and have the grid fill itself.
model CatalogCollection {
  id           String   @id @default(cuid())
  companyId    String
  /// Shopify's collection id.
  externalId   String
  handle       String
  title        String
  /// What the storefront reported, which can outrun what we actually stored.
  productCount Int      @default(0)
  syncedAt     DateTime @default(now())

  company  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products CatalogCollectionProduct[]

  @@unique([companyId, handle])
  @@index([companyId, title])
}

/// Membership, carrying the storefront's own ordering.
model CatalogCollectionProduct {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  /// Position in the collection's own sort order, which is what "manual" means.
  position     Int

  collection CatalogCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    CatalogProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, position])
}

model CatalogProduct {
  id          String   @id @default(cuid())
  companyId   String
  /// Shopify's product id, stable across renames.
  externalId  String
  handle      String
  title       String
  vendor      String?
  productType String?
  url         String
  imageUrl    String?
  /// The store's own product copy ("Body (html)"), flattened to plain text.
  description String?
  /// Formatted as the storefront gives it, e.g. "45.00". A string because it
  /// goes straight into a cell and then into the email verbatim.
  price       String?
  available   Boolean  @default(true)
  /// Comma-joined product tags, so the picker can search on them.
  tags        String   @default("")
  syncedAt    DateTime @default(now())

  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collections CatalogCollectionProduct[]

  @@unique([companyId, externalId])
  @@index([companyId, title])
}

/// Joins a login to a company. Roles: "owner" | "admin" | "member".
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("member")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Pending invitation for someone to join a company.
model Invite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        String    @default("member")
  token       String    @unique
  invitedById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
}

/// An HTML email template containing {{ placeholder_name }} tokens.
model Template {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  description  String?
  html         String
  /// JSON array of placeholder names discovered in `html`, cached on write.
  placeholders String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvals Approval[]
  pushes    KlaviyoPush[]

  @@index([companyId])
}

/// An uploaded .xlsx/.csv, parsed into records that live in the app.
model ContentSheet {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  sourceFilename String?
  /// JSON array of column headers, in sheet order.
  columns        String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rows    SheetRow[]

  @@index([companyId])
}

/// One record from a content sheet: the values for a single email.
model SheetRow {
  id          String    @id @default(cuid())
  sheetId     String
  position    Int
  /// JSON object mapping column header -> string value.
  data        String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  /// Set when someone hides the row: rejected outright, or not ready to show.
  /// A timestamp rather than a flag so the rail can say when, and by whom.
  hiddenAt    DateTime?
  hiddenById  String?

  sheet     ContentSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("RowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  hiddenBy  User?         @relation("RowHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  revisions RowRevision[]
  approvals Approval[]
  notes     RowNote[]
  pushes    KlaviyoPush[]

  @@index([sheetId, position])
}

/// One person signing off one row as rendered in one template.
///
/// The approved thing is the pair, not the row: the same copy in a different
/// layout is a different email and is approved separately. `contentHash`
/// records what was actually on screen, so editing the copy afterwards leaves
/// the approval visibly stale instead of silently standing.
model Approval {
  id          String   @id @default(cuid())
  rowId       String
  templateId  String
  userId      String
  /// Fingerprint of the row values and template at the moment of approval.
  contentHash String
  createdAt   DateTime @default(now())

  row      SheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rowId, templateId, userId])
  @@index([rowId])
  @@index([templateId])
}

/// What this app put into a client's Klaviyo, and when.
///
/// One per row-and-template pair, so pushing the same email twice updates the
/// campaign it made rather than leaving a second one behind for someone to
/// find later and wonder about. Keeping the ids is what makes the second push
/// an update instead of a duplicate.
model KlaviyoPush {
  id                String   @id @default(cuid())
  rowId             String
  templateId        String
  /// Klaviyo's ids for what was created.
  campaignId        String
  messageId         String
  klaviyoTemplateId String
  /// The approval fingerprint of what was pushed, so the app can tell whether
  /// the row has been edited since and the campaign is now out of date.
  contentHash       String
  /// "draft", "scheduled", or "cancelled" -- what this app last did, which is
  /// not necessarily what Klaviyo shows if someone changed it there.
  status            String   @default("draft")
  scheduledFor      DateTime?
  campaignName      String
  /// The audiences as named at push time, for showing where it went.
  audienceNames     String   @default("")
  pushedAt          DateTime @default(now())
  pushedById        String?

  row      SheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  pushedBy User?    @relation(fields: [pushedById], references: [id], onDelete: SetNull)

  @@unique([rowId, templateId])
  @@index([rowId])
}

/// A message on one row, from one person, to whoever else works on it.
///
/// Attached to the row rather than the row-and-template pair that an approval
/// uses. An approval is a statement about one rendered email; a note is a
/// conversation about the send, and splitting it per template would scatter one
/// discussion across as many threads as the sheet has layouts.
model RowNote {
  id        String   @id @default(cuid())
  rowId     String
  /// Null once the author's account is gone. The note stays: a thread with a
  /// hole in it is still worth more than a thread that deletes itself when
  /// someone leaves.
  userId    String?
  body      String
  createdAt DateTime @default(now())

  row  SheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([rowId, createdAt])
}

/// Immutable snapshot of a row's values, written on every save.
model RowRevision {
  id          String   @id @default(cuid())
  rowId       String
  /// JSON object: the row's values *before* this change.
  data        String
  changedById String?
  changedAt   DateTime @default(now())
  note        String?

  row       SheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([rowId, changedAt])
}

/// An image uploaded through the app and served publicly for use in emails.
///
/// The bytes live here rather than on disk or in a bucket so that anyone with
/// a login can add one -- a file committed to the repository can only ever be
/// added by whoever can push to it, which is the wrong shape for a tool the
/// whole team reviews in. Images are small and few; the database handles them
/// comfortably and they are covered by its backups.
model MediaAsset {
  id           String   @id @default(cuid())
  companyId    String
  /// Digest of the bytes. Doubles as the public path, so a URL always points
  /// at exactly the image it was created for and can be cached forever.
  sha256       String
  filename     String
  mimeType     String
  bytes        Bytes
  size         Int
  width        Int?
  height       Int?
  uploadedById String?
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// The same file uploaded twice is one asset, not two.
  @@unique([companyId, sha256])
  @@index([companyId, createdAt])
}
